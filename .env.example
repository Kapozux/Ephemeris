# 复制成 .env 再填。.env 不会进仓库。

# Notion internal integration secret（ntn_ 开头），并把 integration 共享到日记库
NOTION_TOKEN=
# 日记要进的 Notion 库的 data_source_id（不是 database_id）
NOTION_DIARY_DS=

# claude.ai 的登录 cookie（每日自动同步用）
# 取法：claude.ai → 右键「检查」→ Application → Cookies → https://claude.ai
CLAUDE_SESSION_KEY=
CLAUDE_ORG_ID=

# 日记 prompt 里怎么称呼你（默认「用户」）
DIARY_NAME=
