# 复制成 .env 再填。.env 不会进仓库。

# Notion internal integration secret（ntn_ 开头），并把 integration 共享到日记库
NOTION_TOKEN=
# 日记要进的 Notion 库的 data_source_id（不是 database_id）
NOTION_DIARY_DS=

# 这几个不用手动填：打开 Ephemeris，第一次会出「开始用」页，在页面上贴就行（会写进这个文件）。

# claude.ai 的登录 cookie（每日自动同步用）
# 取法：claude.ai → 右键「检查」→ Application → Cookies → https://claude.ai → sessionKey
CLAUDE_SESSION_KEY=
# 可以不填，会自己去取
CLAUDE_ORG_ID=
# 同步先打开哪页（屏蔽工具挡住 claude.ai 首页时，填放行的那个网址；不填就是首页）
CLAUDE_HOME_URL=

# 用哪家模型：deepseek | claude | gemini | openrouter | dashscope（「开始用」页选的那家；不是 claude 就不碰本机的 Claude Code）
EPHEMERIS_PROVIDER=
# DeepSeek 官方 API：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
# 阿里云百炼（通义）：走它上面的 DeepSeek
DASHSCOPE_API_KEY=
# 调模型用的 Gemini key：https://aistudio.google.com/apikey
GEMINI_API_KEY=
# OpenRouter：上面的 DeepSeek / Gemini、证据卡的向量、「设置 → 交接包」
OPENROUTER_API_KEY=
# 你在哪个时区（小时，默认 8 = 北京时间）
EPHEMERIS_UTC_OFFSET=
# 模型走哪条：gemini（默认）| verbatim（跟着 Verbatim 的分流）
EPHEMERIS_LLM=

# 日记 prompt 里怎么称呼你（默认「用户」）
DIARY_NAME=
