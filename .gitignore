# 白名单：这个目录默认什么都不进仓库，只放行下面列出的代码文件。
# 聊天记录、数据库、日记缓存、Chrome 登录态、.env，以及以后任何新下载 / 新建的文件和文件夹，
# 都不在名单里，所以自动被挡住 —— 不用每次记得来加一行。
/*
!/.gitignore
!/.env.example
!/README.md
!/README.zh-CN.md
!/run.sh
!/run.bat
!/requirements.txt
!/*.command
!/static/
!/templates/
!/tests/
!/skills/
!/research/

# 白名单里的目录也只放行代码类型
/static/*
!/static/*.js
!/static/*.css
!/static/*.svg
!/static/js/
/static/js/*
!/static/js/*.js
!/static/vendor/
/static/vendor/*
!/static/vendor/*.js
/templates/*
!/templates/*.html
/tests/*
!/tests/*.py
/skills/*
!/skills/*.md
/research/*
!/research/*.py
!/research/*.md
!/research/*.json
!/research/*.html
!/research/measures/
/research/measures/*
!/research/measures/*.py

# README 用的 logo 和动图（动图是虚构人物 Sam 的演示库录的，见本地 devtools/readme_demo.py）
!/docs/
/docs/*
!/docs/*.svg
!/docs/*.gif

# 代码都在 src/（11-03 从根目录挪进去）：页面接口 src/routes/，往里拉数据的同步 src/sources/
!/src/
/src/*
!/src/*.py
!/src/touchid.swift
!/src/routes/
/src/routes/*
!/src/routes/*.py
!/src/sources/
/src/sources/*
!/src/sources/*.py
# 在浏览器控制台里跑的导出脚本
!/scripts/
/scripts/*
!/scripts/*.js
