# 复制成 .env 再填。.env 不会进仓库。

# Notion internal integration secret（ntn_ 开头），并把 integration 共享到日记库
NOTION_TOKEN=
# 日记要进的 Notion 库的 data_source_id（不是 database_id）
NOTION_DIARY_DS=

# 这几个不用手动填：打开 Ephemeris，第一次会出「开始用」页，在页面上贴就行（会写进这个文件）。

# claude.ai 的登录 cookie（每日自动同步用）
# 取法：claude.ai → 右键「检查」→ Application → Cookies → https://claude.ai → sessionKey
CLAUDE_SESSION_KEY=
# 可以不填，会自己去取
CLAUDE_ORG_ID=

# 调模型用的 Gemini key：https://aistudio.google.com/apikey
GEMINI_API_KEY=
# 只有「设置 → 交接包」要用（OpenRouter 上的 Claude Opus）
OPENROUTER_API_KEY=
# 模型走哪条：gemini（默认）| verbatim（跟着 Verbatim 的分流）
EPHEMERIS_LLM=

# 日记 prompt 里怎么称呼你（默认「用户」）
DIARY_NAME=
